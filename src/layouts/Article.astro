---
import Base from './Base.astro';
import Share from '../components/Share.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import { visible, formatDate, readingTime } from '../lib/content';
interface Props {
  entry: CollectionEntry<'notes'> | CollectionEntry<'research'>;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const related = visible(await getCollection('notes'))
  .filter((note) => note.id !== entry.id)
  .slice(0, 2);
const isResearch = entry.collection === 'research';
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  article
  automated={entry.data.authorship === 'automated'}
  published={entry.data.published}
  updated={entry.data.updated}
>
  <article class="shell article-page">
    <header class="article-heading">
      <a class="eyebrow back-link" href={isResearch ? '/research/' : '/notes/'}>
        ← {isResearch ? 'Research fieldnotes' : 'All fieldnotes'}
      </a>
      <div class="article-topics">
        {entry.data.topics.map((topic) => (
          <span class="pill">{topic}</span>
        ))}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <div class="article-byline">
        {entry.data.authorship === 'automated' ? (
          <a href="/editorial/">Model Fieldnotes · Automated briefing</a>
        ) : (
          <a href="/about/">By Swapnil</a>
        )}
        <time datetime={entry.data.published.toISOString()}>
          {formatDate(entry.data.published)}
        </time>
        <span>{readingTime(entry.body)} min read</span>
        {entry.data.updated && (
          <span>Updated {formatDate(entry.data.updated)}</span>
        )}
      </div>
    </header>
    <div class="article-grid">
      <aside class="article-sidebar">
        <nav aria-label="On this page">
          <p class="eyebrow">In this fieldnote</p>
          <ol>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            <li>
              <a href="#sources">Sources & further reading</a>
            </li>
          </ol>
        </nav>
        <Share />
      </aside>
      <div>
        <div class="prose">
          <slot />
        </div>
        <section id="sources" class="sources">
          <p class="eyebrow">Follow the evidence</p>
          <h2>Sources & further reading</h2>
          <ol>
            {entry.data.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title} ↗</a>
              </li>
            ))}
          </ol>
          <p class="source-note">
            {entry.collection === 'notes'
              ? `Sources checked ${formatDate(entry.data.reviewed)}.`
              : `${entry.data.collection === 'Foundations' ? 'A foundational collection, not a current model leaderboard.' : 'A weekly research selection.'} Results described here are reported by the paper authors; they have not been independently reproduced by Model Fieldnotes.`}{' '}
            {entry.data.authorship === 'automated'
              ? 'AI-generated with automated evidence checks; this is not a claim of human review.'
              : 'Research and drafting assisted by AI.'}
          </p>
          <a
            class="text-link"
            href={`https://github.com/swapupg/swapupg.github.io/issues/new?title=${encodeURIComponent(`Correction: ${entry.data.title}`)}`}
          >
            Suggest a correction ↗
          </a>
        </section>
        <section class="related">
          <p class="eyebrow">Keep exploring</p>
          {related.map((note) => (
            <a href={`/notes/${note.id}/`}>
              {note.data.title}
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </section>
      </div>
    </div>
  </article>
</Base>
