---
import Base from './Base.astro';
import Share from '../components/Share.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import { visible, formatDate, readingTime } from '../lib/content';
import { attribution } from '../lib/identity';
import { simulationLink } from '../lib/fieldbook';
interface Props {
  entry:
    | CollectionEntry<'notes'>
    | CollectionEntry<'research'>
    | CollectionEntry<'fieldbook'>;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const related = visible(await getCollection('notes'))
  .filter((note) => note.id !== entry.id && note.data.authorship === 'human')
  .sort(
    (a, b) =>
      Number(b.data.topics.some((topic) => entry.data.topics.includes(topic))) -
      Number(a.data.topics.some((topic) => entry.data.topics.includes(topic))),
  )
  .slice(0, 2);
const isResearch = entry.collection === 'research';
const guides =
  entry.collection === 'fieldbook'
    ? visible(await getCollection('fieldbook')).sort(
        (a, b) => a.data.order - b.data.order,
      )
    : [];
const guideIndex = guides.findIndex((guide) => guide.id === entry.id);
const previous = guides[guideIndex - 1];
const next = guides[guideIndex + 1];
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  article
  collection={entry.collection}
  automated={entry.data.authorship === 'automated'}
  published={entry.data.published}
  updated={entry.data.updated}
>
  <article class="shell article-page">
    <header class="article-heading">
      <a class="eyebrow back-link" href={`/${entry.collection}/`}>
        ←{' '}
        {entry.collection === 'fieldbook'
          ? 'Agent Reliability Fieldbook'
          : isResearch
            ? 'Research fieldnotes'
            : 'All fieldnotes'}
      </a>
      <div class="article-topics">
        {entry.data.authorship === 'human' &&
          entry.data.topics.includes('Leadership') && (
            <a class="pill evidence-label" href="/leadership/">
              Leadership & Organizations →
            </a>
          )}
        {entry.collection === 'fieldbook' && (
          <span class="pill evidence-label">{entry.data.evidence}</span>
        )}
        {entry.data.topics
          .filter(
            (topic) =>
              topic !== 'Leadership' || entry.data.authorship !== 'human',
          )
          .map((topic) => (
            <span class="pill">{topic}</span>
          ))}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <div class="article-byline">
        {entry.data.authorship === 'automated' ? (
          <a href="/editorial/">{attribution(true)}</a>
        ) : (
          <a href="/about/">{attribution()}</a>
        )}
        <time datetime={entry.data.published.toISOString()}>
          {formatDate(entry.data.published)}
        </time>
        <span>{readingTime(entry.body)} min read</span>
        {entry.data.updated && (
          <span>Updated {formatDate(entry.data.updated)}</span>
        )}
      </div>
      {entry.collection === 'fieldbook' && (
        <div class="guide-launch">
          <p>
            Deterministic teaching simulation · Revision{' '}
            {entry.data.scenario.revision}. These outcomes do not measure
            real-model performance. Both links open paused at the first step.
          </p>
          <div class="guide-actions">
            <a
              class="button primary"
              href={simulationLink(entry.data.scenario, 'baseline')}
            >
              Run the failure <span aria-hidden="true">↗</span>
            </a>
            <a
              class="button secondary"
              href={simulationLink(entry.data.scenario, 'repaired')}
            >
              Explore the repair <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      )}
    </header>
    <div class="article-grid">
      <aside class="article-sidebar">
        <nav aria-label="On this page">
          <p class="eyebrow">In this fieldnote</p>
          <ol>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            <li>
              <a href="#sources">Sources & further reading</a>
            </li>
          </ol>
        </nav>
        <Share />
      </aside>
      <div>
        <div class="prose">
          <slot />
        </div>
        <section id="sources" class="sources">
          <p class="eyebrow">Follow the evidence</p>
          <h2>Sources & further reading</h2>
          <ol>
            {entry.data.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title} ↗</a>
              </li>
            ))}
          </ol>
          <p class="source-note">
            {entry.collection !== 'research'
              ? `Sources checked ${formatDate(entry.data.reviewed)}.`
              : `${entry.data.collection === 'Foundations' ? 'A foundational collection, not a current model leaderboard.' : 'A weekly research selection.'} Results described here are reported by the paper authors; they have not been independently reproduced by Model Fieldnotes.`}{' '}
            {entry.data.authorship === 'automated'
              ? 'AI-generated with automated evidence checks; this is not a claim of human review.'
              : 'Research and drafting assisted by AI.'}
          </p>
          <a
            class="text-link"
            href={`https://github.com/swapupg/swapupg.github.io/issues/new?title=${encodeURIComponent(`Correction: ${entry.data.title}`)}`}
          >
            Suggest a correction ↗
          </a>
        </section>
        {entry.collection === 'fieldbook' && (
          <nav class="guide-pagination" aria-label="Fieldbook entries">
            {previous && (
              <a href={`/fieldbook/${previous.id}/`}>
                <span>← Previous guide</span>
                <strong>{previous.data.title}</strong>
              </a>
            )}
            {next && (
              <a href={`/fieldbook/${next.id}/`}>
                <span>Next guide →</span>
                <strong>{next.data.title}</strong>
              </a>
            )}
          </nav>
        )}
        <section class="related">
          <p class="eyebrow">Keep exploring</p>
          {related.map((note) => (
            <a href={`/notes/${note.id}/`}>
              {note.data.title}
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </section>
      </div>
    </div>
  </article>
</Base>
