---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { identity, attribution, socialCardPath } from '../lib/identity';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  automated?: boolean;
  published?: Date;
  updated?: Date;
  collection?: string;
}
const {
  title = identity.headline,
  description = `${identity.description} By ${identity.name}.`,
  article = false,
  automated = false,
  published,
  updated,
  collection,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = article
  ? socialCardPath(
      collection || 'notes',
      Astro.url.pathname.split('/').filter(Boolean).at(-1)!,
    )
  : '/assets/social-preview.png';
const nav = [
  ['Fieldbook', '/fieldbook/'],
  ['Perspectives', '/notes/'],
  ['Developments', '/developments/'],
  ['Research', '/research/'],
  ['Projects', '/projects/'],
  ['About', '/about/'],
];
const structured = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      url: canonical.href,
      author: {
        '@type': automated ? 'Organization' : 'Person',
        name: automated ? 'Model Fieldnotes' : identity.name,
        url: new URL(automated ? '/editorial/' : '/about/', Astro.site).href,
      },
      datePublished: published?.toISOString(),
      dateModified: (updated || published)?.toISOString(),
      image: new URL(socialImage, Astro.site).href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Model Fieldnotes',
      url: Astro.site,
      description,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} — Model Fieldnotes</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Model Fieldnotes — writing by ${identity.name}`}
      href="/writing/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Model Fieldnotes — all writing"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Model Fieldnotes — research"
      href="/research/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Model Fieldnotes — Developments"
      href="/developments/rss.xml"
    />
    <meta property="og:title" content={`${title} — Model Fieldnotes`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage, Astro.site)} />
    <meta
      property="og:image:alt"
      content={`Model Fieldnotes. ${title} ${attribution(automated)}.`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    {published && (
      <meta
        property="article:published_time"
        content={published.toISOString()}
      />
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    ></script>
    <script is:inline>
      try {
        const preference = localStorage.getItem('mfn-theme');
        if (preference === 'light' || preference === 'dark')
          document.documentElement.dataset.theme = preference;
      } catch {
        /* System theme works without storage. */
      }
      function forwardExperiment() {
        if (
          location.pathname === '/' &&
          location.hash.startsWith('#/experiment/')
        )
          location.replace('/agent-explainer/' + location.hash);
      }
      forwardExperiment();
      window.addEventListener('hashchange', forwardExperiment);
      const restoreFragment =
        performance.getEntriesByType('navigation')[0]?.type === 'reload' &&
        location.hash &&
        !location.hash.startsWith('#/');
      // A reload's saved scroll position can otherwise overwrite the fragment
      // after load, especially when a section link was followed immediately.
      if (restoreFragment) history.scrollRestoration = 'manual';
      window.addEventListener('pageshow', () => {
        if (!restoreFragment) return;
        let id;
        try {
          id = decodeURIComponent(location.hash.slice(1));
        } catch {
          history.scrollRestoration = 'auto';
          return;
        }
        document.fonts.ready.then(() =>
          requestAnimationFrame(() => {
            document
              .getElementById(id)
              ?.scrollIntoView({ behavior: 'instant', block: 'start' });
            history.scrollRestoration = 'auto';
          }),
        );
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Model Fieldnotes home">
        <Mark />
        <span>
          Model
          <br />
          <strong>Fieldnotes</strong>
        </span>
      </a>
      <nav aria-label="Main navigation">
        {nav.map(([label, href]) => (
          <a
            href={href}
            aria-current={
              (href === '/developments/' &&
                collection === 'notes' &&
                automated) ||
              (Astro.url.pathname.startsWith(href) &&
                !(href === '/notes/' && automated))
                ? 'page'
                : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="header-tools">
        <a
          class="github-link"
          href="https://github.com/swapupg"
          aria-label={`${identity.name} on GitHub`}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18"
              stroke="currentColor"
              stroke-width="1.6"
            />
          </svg>
          <span>GitHub ↗</span>
        </a>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch color theme"
          hidden
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="8"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="footer-intro">
        <a class="wordmark" href="/">
          <Mark />
          <span>
            Model
            <br />
            <strong>Fieldnotes</strong>
          </span>
        </a>
        <p>
          {identity.philosophy}
          <br />
          An independent project by {identity.name}.
        </p>
      </div>
      <div class="footer-links">
        <a href="/developments/">Developments</a>
        <a href="/leadership/">Leadership & Organizations</a>
        <a href="/writing/rss.xml">Follow my writing ↗</a>
        <a href="/rss.xml">All writing & briefings ↗</a>
        <a href="https://github.com/swapupg">GitHub ↗</a>
        <a href="/about/#editorial-principles">Editorial principles</a>
        <a href="/editorial/">Automation policy</a>
        <a href="/privacy/">Privacy</a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Model Fieldnotes</span>
        <span>Built in the open. No tracking scripts.</span>
        <a href="https://github.com/swapupg/swapupg.github.io">
          Website source ↗
        </a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const dark = document.documentElement.dataset.theme
            ? document.documentElement.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = dark ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          toggle.setAttribute(
            'aria-label',
            `Switch to ${dark ? 'dark' : 'light'} theme`,
          );
          try {
            localStorage.setItem('mfn-theme', theme);
          } catch {
            /* Session-only theme still works. */
          }
        });
      }
    </script>
  </body>
</html>
