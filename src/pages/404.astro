---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="Find your way back to the lab, fieldnotes, or research collection."
>
  <section class="shell page-content not-found">
    <p class="eyebrow">404 / An unexplored path</p>
    <h1>
      This page isn’t
      <br />
      in the notebook.
    </h1>
    <p>
      The link may have changed, or the page may not exist. There is still
      plenty to explore.
    </p>
    <a class="button primary" href="/">
      Back to the lab →
    </a>
    <a class="text-link" href="/notes/">
      Browse the fieldnotes
    </a>
  </section>
</Base>
