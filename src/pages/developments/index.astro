---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WritingArchive from '../../components/WritingArchive.astro';
import { visible } from '../../lib/content';
import { automatedNotes } from '../../lib/editorial-sections';
const notes = visible([
  ...(await getCollection('developments')),
  ...automatedNotes(await getCollection('notes')),
]);
---

<Base
  title="Developments"
  description="Noteworthy AI releases and research: what changed, why it matters, and what the evidence does and does not establish."
>
  <div class="shell page-content">
    <header class="page-heading">
      <p class="eyebrow">Developments / The changing AI landscape</p>
      <h1>
        What’s new.
        <br />
        <span>What’s worth examining.</span>
      </h1>
      <p>
        Noteworthy releases, research, and tools—explained through the decisions
        they could change.
      </p>
      <a class="text-link" href="/developments/rss.xml">
        Follow developments via RSS ↗
      </a>
    </header>
    <div class="development-method" aria-label="How we cover developments">
      <div>
        <h2>What changed?</h2>
        <p>The release, its date, and the original source.</p>
      </div>
      <div>
        <h2>Why might it matter?</h2>
        <p>A practical implication for builders and leaders.</p>
      </div>
      <div>
        <h2>What remains unproven?</h2>
        <p>Vendor claims, evidence limits, and the next useful test.</p>
      </div>
    </div>
    <p class="archive-pathway">
      Release analysis is AI-assisted and linked to original sources. Automated
      briefings carry their own organizational byline. This is a selective
      reading desk, not a complete news feed. For longer arguments, explore{' '}
      <a href="/notes/">Perspectives</a>.
    </p>
    <h2 class="archive-heading">Latest developments</h2>
    <WritingArchive notes={notes} label="developments" />
  </div>
</Base>
