---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WritingArchive from '../../components/WritingArchive.astro';
import { perspectiveNotes } from '../../lib/editorial-sections';
const notes = perspectiveNotes(await getCollection('notes'));
---

<Base
  title="Perspectives"
  description="How AI changes what we build, how we lead, and how organizations work. Analysis by Swapnil Upganlawar on leadership, strategy, economics, and engineering judgment."
>
  <div class="shell page-content">
    <header class="page-heading">
      <p class="eyebrow">Perspectives / By Swapnil Upganlawar</p>
      <h1>
        How AI changes
        <br />
        <span>the decisions we make.</span>
      </h1>
      <p>
        How AI changes what we build, how we lead, and how organizations work.
      </p>
    </header>
    <section class="perspective-topics" aria-label="Three areas of focus">
      <article>
        <p class="eyebrow">01 / Leadership & Organizations</p>
        <h2>How should we lead?</h2>
        <p>
          Changing management roles, team design, accountability, and adoption.
        </p>
        <a class="text-link" href="/leadership/">
          Explore leadership →
        </a>
      </article>
      <article>
        <p class="eyebrow">02 / AI Strategy & Economics</p>
        <h2>What makes AI worth doing?</h2>
        <p>
          Investment decisions, costs, and the difference between activity and
          useful outcomes.
        </p>
        <a class="text-link" href="/notes/cost-of-a-completed-task/">
          Read about the economics →
        </a>
      </article>
      <article>
        <p class="eyebrow">03 / Engineering Judgment</p>
        <h2>What should we trust?</h2>
        <p>
          Reliability, evaluation, and the tradeoffs behind putting AI into
          production.
        </p>
        <a class="text-link" href="/notes/comparing-ai-models/">
          Explore model evaluation →
        </a>
      </article>
    </section>
    <aside class="archive-pathway">
      Looking for releases and research updates?{' '}
      <a href="/developments/">
        Explore Developments <span aria-hidden="true">→</span>
      </a>{' '}
      for source-based release analysis and clearly labeled automated briefings.
    </aside>
    <h2 class="archive-heading">All perspectives</h2>
    <WritingArchive notes={notes} label="perspectives" showFocus />
  </div>
</Base>
<script is:inline>
  // Preserve previously shared briefing filters after separating the archives.
  if (new URLSearchParams(location.search).get('format') === 'Daily brief') {
    location.replace('/developments/' + location.search + location.hash);
  }
</script>
