---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { visible, pad } from '../../lib/content';
const guides = visible(await getCollection('fieldbook')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Agent Reliability Fieldbook"
  description="Three simulation-based guides to agent failures: duplicate actions, forgotten constraints, and premature completion. Inspect the mechanism, repair, and limits."
>
  <div class="shell page-content">
    <header class="page-heading">
      <p class="eyebrow">Model Fieldnotes / The Fieldbook</p>
      <h1>
        Agent reliability,
        <br />
        <span>one failure at a time.</span>
      </h1>
      <p>
        A practical fieldbook for engineers taking agents beyond the demo.
        Understand a failure, inspect a repair, and decide what to test in your
        own system.
      </p>
    </header>
    <div class="fieldbook-method" aria-label="How to use the Fieldbook">
      <span>
        <b>01</b> Read the mechanism
      </span>
      <span>
        <b>02</b> Run the simulation
      </span>
      <span>
        <b>03</b> Inspect the repair
      </span>
    </div>
    <div class="fieldbook-grid">
      {guides.map((guide) => (
        <article class="fieldbook-card">
          <div class="note-meta">
            <span>{guide.data.evidence}</span>
            <span class="coordinate">{pad(guide.data.order)}</span>
          </div>
          <h2>
            <a href={`/fieldbook/${guide.id}/`}>
              {guide.data.title}
              <span aria-hidden="true"> ↗</span>
            </a>
          </h2>
          <p>{guide.data.description}</p>
          <span class="guide-revision">
            Agent Explainer · Revision {guide.data.scenario.revision}
          </span>
        </article>
      ))}
    </div>
    <section
      class="fieldbook-limits prose standalone-prose"
      aria-labelledby="fieldbook-limits"
    >
      <h2 id="fieldbook-limits">What you can learn here</h2>
      <p>
        These are deterministic, rule-based simulations. They expose a failure
        mechanism and the effect of one repair under explicit assumptions. They
        do not use live models or measure model performance.
      </p>
      <p>
        Each guide separates the simulated outcome from production
        considerations. Retaining instructions does not guarantee compliance;
        permissions must independently constrain actions. The{' '}
        <a href="/projects/agent-explainer/">Agent Explainer project</a> remains
        in public beta.
      </p>
      <a
        class="text-link"
        href="https://github.com/swapupg/swapupg.github.io/issues/new?title=Fieldbook%20feedback"
      >
        Suggest a correction or a failure to explore{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Base>
