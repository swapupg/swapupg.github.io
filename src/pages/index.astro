---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LabDiagram from '../components/LabDiagram.astro';
import NoteCard from '../components/NoteCard.astro';
import { visible, signed, pad, formatDate } from '../lib/content';
import { identity } from '../lib/identity';
import { leadershipNotes } from '../lib/leadership';
import {
  featuredEssay,
  perspectives,
  requireSignedNote,
} from '../lib/perspectives';
const allNotes = visible(await getCollection('notes'));
const featured = requireSignedNote(allNotes, featuredEssay.id);
const leadership = leadershipNotes(allNotes)
  .filter((note) => note.id !== featured.id)
  .slice(0, 2);
for (const perspective of perspectives) {
  if (perspective.reading.noteId)
    requireSignedNote(allNotes, perspective.reading.noteId);
}
const latestBrief = allNotes
  .filter(
    (n) => n.data.kind === 'Daily brief' && n.data.authorship === 'automated',
  )
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())[0];
const notes = signed(allNotes)
  .filter((note) => note.id !== featured.id)
  .sort(
    (a, b) =>
      b.data.published.getTime() - a.data.published.getTime() ||
      a.data.number - b.data.number,
  )
  .slice(0, 4);
const issue = visible(await getCollection('research')).sort(
  (a, b) => b.data.issue - a.data.issue,
)[0];
---

<Base>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span> Model Fieldnotes —
        by Swapnil Upganlawar
      </p>
      <h1>
        AI agents,
        <br />
        <span>beyond the demo.</span>
      </h1>
      <p class="hero-thesis">
        <strong>My view:</strong> {identity.thesis}
      </p>
      <p class="hero-description">{identity.introduction}</p>
      <div class="hero-actions">
        <a class="button primary" href={featuredEssay.href}>
          Read my perspective <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/fieldbook/">
          Explore the Fieldbook <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="byline">
        <img
          class="author-avatar"
          src="/images/swapnil-upganlawar.jpg"
          width="800"
          height="800"
          alt=""
        />{' '}
        By <a href="/about/">{identity.name}</a>
        <span class="byline-rule" aria-hidden="true"></span>{' '}
        {identity.philosophy}
      </p>
    </div>
    <LabDiagram />
  </section>
  <section class="perspectives-section" aria-labelledby="perspectives-heading">
    <div class="shell section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / My perspective</p>
          <h2 id="perspectives-heading">Where I think AI is heading.</h2>
          <p class="section-intro">
            Three shifts shaping the decisions I explore here.
          </p>
        </div>
      </div>
      <div class="perspectives-grid">
        {perspectives.map((perspective, index) => (
          <article class="perspective-card">
            <span class="eyebrow">0{index + 1} / A shift to watch</span>
            <h3>
              <a href={`${featuredEssay.href}#${perspective.section}`}>
                {perspective.title} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{perspective.thesis}</p>
            <p class="perspective-implication">
              <strong>For leaders</strong>
              {perspective.implication}
            </p>
            <a class="perspective-reading" href={perspective.reading.href}>
              <span class="eyebrow">Explore the work</span>
              <span>
                {perspective.reading.label} <span aria-hidden="true">→</span>
              </span>
            </a>
          </article>
        ))}
      </div>
      <p class="perspective-note">
        These are personal perspectives. The Fieldbook’s simulations explain
        specific mechanisms; they do not establish these forecasts.
      </p>
    </div>
  </section>
  <section
    class="shell leadership-feature"
    aria-labelledby="leadership-heading"
  >
    <div>
      <p class="eyebrow">Leadership & Organizations</p>
      <h2 id="leadership-heading">How AI changes the work of leading.</h2>
      <p>
        Management, team design, architecture, and accountability. My analysis,
        with readings that make the evidence and its limits visible.
      </p>
      <a class="text-link" href="/leadership/">
        Explore Leadership & Organizations <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="leadership-feature-links">
      {leadership.map((note) => (
        <a href={`/notes/${note.id}/`}>
          <span class="eyebrow">Signed essay</span>
          <strong>{note.data.title}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section
    class="section shell"
    id="projects"
    aria-labelledby="project-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / The open lab</p>
        <h2 id="project-heading">An idea you can get your hands on.</h2>
      </div>
      <a class="text-link" href="/projects/">
        Explore projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <article class="featured-project">
      <div class="project-copy">
        <div class="project-label">
          <span class="eyebrow">Deterministic simulations</span>
          <span class="pill">Public beta</span>
        </div>
        <h3>Agent Explainer</h3>
        <p class="project-lead">
          See how AI agents work.
          <br />
          And why they fail.
        </p>
        <p>
          Watch a failure. Inspect the cause. Apply one repair and replay. Three
          browser-based simulations make the invisible parts of an agent system
          visible.
        </p>
        <div class="project-actions">
          <a class="button primary" href="/agent-explainer/">
            Try Agent Explainer <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/projects/agent-explainer/">
            Inside the project →
          </a>
        </div>
        <p class="project-guide-link">
          Read the <a href="/fieldbook/">Agent Reliability Fieldbook</a> for
          each repair’s mechanism and production limits.
        </p>
        <div class="project-footnotes">
          <span>No API keys</span>
          <span>Open source</span>
          <span>Runs locally in your browser</span>
        </div>
      </div>
      <figure class="project-visual">
        <div class="mini-window">
          <span class="window-dot" aria-hidden="true"></span>
          <span>agent-explainer / duplicate-action</span>
          <span aria-hidden="true">↗</span>
        </div>
        <img
          src="/assets/agent-explainer.webp"
          width="1200"
          height="1282"
          alt="Agent Explainer showing the duplicate-action experiment with agent context, activity, and world state."
          loading="lazy"
        />
        <figcaption>One request. Two tickets. Find out why.</figcaption>
      </figure>
    </article>
  </section>
  <section
    class="section shell"
    id="signed-notes"
    aria-labelledby="notes-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / Signed notes & explanations</p>
        <h2 id="notes-heading">Notes from the work.</h2>
      </div>
      <a class="text-link" href="/notes/">
        All fieldnotes <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="notes-grid">
      {notes.map((note) => (
        <NoteCard note={note} />
      ))}
    </div>
  </section>
  {issue && (
    <section class="research-feature">
      <div class="shell research-grid">
        <div class="research-intro">
          <p class="eyebrow">04 / The reading room</p>
          <div class="issue-number" aria-hidden="true">
            {pad(issue.data.issue)}
            <span>
              Research
              <br />
              fieldnotes
            </span>
          </div>
          <h2>{issue.data.title}</h2>
          <p>
            One paper in depth. Four more in perspective. What the evidence
            says, where it stops, and why it matters for builders.
          </p>
          <div class="research-meta">
            {issue.data.collection} · {formatDate(issue.data.published)}
          </div>
          <a class="button primary" href={`/research/${issue.id}/`}>
            Read the collection <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ol class="paper-list">
          {issue.data.papers.map((paper, i) => (
            <li>
              <span class="paper-index">0{i + 1}</span>
              <div>
                <h3>{paper.title}</h3>
                <p>{paper.finding}</p>
                <span class="paper-year">
                  {paper.published.slice(0, 4)} ·{' '}
                  {i === 0 ? 'In depth' : 'Research note'}
                </span>
              </div>
              <a
                href={paper.url}
                aria-label={`Read original paper: ${paper.title}`}
              >
                ↗
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {latestBrief && (
    <section class="shell latest-brief" aria-labelledby="brief-heading">
      <div>
        <p class="eyebrow">
          Model Fieldnotes · Automated briefing ·{' '}
          {formatDate(latestBrief.data.published)}
        </p>
        <h2 id="brief-heading">
          <a href={`/notes/${latestBrief.id}/`}>{latestBrief.data.title} ↗</a>
        </h2>
        <p>{latestBrief.data.description}</p>
      </div>
      <a class="text-link" href="/notes/?format=Daily+brief">
        All briefings →
      </a>
    </section>
  )}
  <section class="section shell author-section" id="about">
    <div>
      <p class="eyebrow">05 / Behind the fieldnotes</p>
      <div class="author-identity">
        <img
          src="/images/swapnil-upganlawar.jpg"
          width="800"
          height="800"
          alt="Swapnil Upganlawar"
          loading="lazy"
        />
        <div>
          <h2>Hi, I’m Swapnil Upganlawar.</h2>
          <p class="author-role">
            AI & engineering leader. Builder of Model Fieldnotes.
          </p>
        </div>
      </div>
    </div>
    <div>
      <p class="author-lead">
        I connect engineering depth with product judgment: how agents fail, how
        to evaluate them, and what useful outcomes cost.
      </p>
      <p>
        My background spans more than two decades: machine learning research at
        Carnegie Mellon, founding software ventures, and AI leadership at
        Gartner, Amazon, and AWS. I hold an MBA from Wharton and an MS in
        Bioinformatics from Carnegie Mellon. Model Fieldnotes brings that
        experience to practical decisions for engineering leaders and senior
        builders.
      </p>
      <div class="author-links">
        <a class="text-link" href="/about/">
          More about me <span aria-hidden="true">→</span>
        </a>
        <a
          class="text-link"
          href="https://www.linkedin.com/in/swapnilupganlawar/"
          rel="me"
        >
          Find me on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="follow-strip shell">
    <div>
      <p class="eyebrow">Keep a thread of curiosity open</p>
      <h2>Follow the next fieldnote.</h2>
      <p>
        Follow signed notes, guides, and research in your feed reader. Automated
        briefings are available in the combined feed.
      </p>
    </div>
    <div>
      <a class="button primary" href="/writing/rss.xml">
        Follow my writing <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/rss.xml">
        All writing & briefings ↗
      </a>
      <a class="text-link" href="https://github.com/swapupg">
        Follow on GitHub ↗
      </a>
    </div>
  </section>
</Base>
