---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LabDiagram from '../components/LabDiagram.astro';
import NoteCard from '../components/NoteCard.astro';
import { visible, signed, pad, formatDate } from '../lib/content';
import { identity } from '../lib/identity';
const allNotes = visible(await getCollection('notes'));
const latestBrief = allNotes
  .filter((n) => n.data.kind === 'Daily brief')
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())[0];
const notes = signed(allNotes)
  .sort(
    (a, b) =>
      b.data.published.getTime() - a.data.published.getTime() ||
      a.data.number - b.data.number,
  )
  .slice(0, 4);
const issue = visible(await getCollection('research')).sort(
  (a, b) => b.data.issue - a.data.issue,
)[0];
---

<Base>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span> Model Fieldnotes —
        by Swapnil Upganlawar
      </p>
      <h1>
        AI agents,
        <br />
        <span>beyond the demo.</span>
      </h1>
      <p class="hero-description">{identity.description}</p>
      <div class="hero-actions">
        <a class="button primary" href="/fieldbook/">
          Explore the Fieldbook <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/agent-explainer/">
          Try Agent Explainer <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="byline">
        <img
          class="author-avatar"
          src="/images/swapnil-upganlawar.jpg"
          width="800"
          height="800"
          alt=""
        />{' '}
        By <a href="/about/">{identity.name}</a>
        <span class="byline-rule" aria-hidden="true"></span>{' '}
        {identity.philosophy}
      </p>
    </div>
    <LabDiagram />
  </section>
  <section class="focus-strip" aria-label="Questions this lab explores">
    <div class="shell focus-grid">
      <a href="/fieldbook/">
        <span class="eyebrow">Reliability</span>
        <strong>Will the agent complete the task correctly?</strong>
        <span class="focus-more">Inspect the failures ↗</span>
      </a>
      <a href="/notes/cost-of-a-completed-task/">
        <span class="eyebrow">Economics</span>
        <strong>What does a useful outcome actually cost?</strong>
        <span class="focus-more">Count the whole task ↗</span>
      </a>
      <a href="/notes/comparing-ai-models/">
        <span class="eyebrow">Engineering judgment</span>
        <strong>What should we automate, and under what controls?</strong>
        <span class="focus-more">Define the evaluation ↗</span>
      </a>
    </div>
  </section>
  <section class="section shell" aria-labelledby="start-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Start here</p>
        <h2 id="start-heading">Three ways into the work.</h2>
      </div>
    </div>
    <div class="start-grid">
      <article class="start-card start-featured">
        <span class="eyebrow">Understand the failure</span>
        <h3>
          <a href="/fieldbook/">
            Agent Reliability Fieldbook <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          Three simulation-based guides. Follow the failure, inspect the repair,
          and understand its limits.
        </p>
        <span class="start-kind">Interactive learning + practical guides</span>
      </article>
      <article class="start-card">
        <span class="eyebrow">Count the outcome</span>
        <h3>
          <a href="/notes/cost-of-a-completed-task/">
            The cost of a completed task <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          Tokens, tools, retries, and failures belong in the same calculation.
          Work through an illustrative example.
        </p>
        <span class="start-kind">Economics / Essay</span>
      </article>
      <article class="start-card">
        <span class="eyebrow">Make the decision</span>
        <h3>
          <a href="/notes/comparing-ai-models/">
            How to compare AI models for your application{' '}
            <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          Define success for your task, build a useful evaluation, and make a
          choice you can explain.
        </p>
        <span class="start-kind">Engineering judgment / Essay</span>
      </article>
    </div>
  </section>
  <section
    class="section shell"
    id="projects"
    aria-labelledby="project-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / The open lab</p>
        <h2 id="project-heading">An idea you can get your hands on.</h2>
      </div>
      <a class="text-link" href="/projects/">
        Explore projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <article class="featured-project">
      <div class="project-copy">
        <div class="project-label">
          <span class="eyebrow">Deterministic simulations</span>
          <span class="pill">Public beta</span>
        </div>
        <h3>Agent Explainer</h3>
        <p class="project-lead">
          See how AI agents work.
          <br />
          And why they fail.
        </p>
        <p>
          Watch a failure. Inspect the cause. Apply one repair and replay. Three
          browser-based simulations make the invisible parts of an agent system
          visible.
        </p>
        <div class="project-actions">
          <a class="button primary" href="/agent-explainer/">
            Open Agent Explainer <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/projects/agent-explainer/">
            Inside the project →
          </a>
        </div>
        <div class="project-footnotes">
          <span>No API keys</span>
          <span>Open source</span>
          <span>Runs locally in your browser</span>
        </div>
      </div>
      <figure class="project-visual">
        <div class="mini-window">
          <span class="window-dot" aria-hidden="true"></span>
          <span>agent-explainer / duplicate-action</span>
          <span aria-hidden="true">↗</span>
        </div>
        <img
          src="/assets/agent-explainer.webp"
          width="1200"
          height="1282"
          alt="Agent Explainer showing the duplicate-action experiment with agent context, activity, and world state."
          loading="lazy"
        />
        <figcaption>One request. Two tickets. Find out why.</figcaption>
      </figure>
    </article>
  </section>
  <section
    class="section shell"
    id="signed-notes"
    aria-labelledby="notes-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / Signed notes & explanations</p>
        <h2 id="notes-heading">Notes from the work.</h2>
      </div>
      <a class="text-link" href="/notes/">
        All fieldnotes <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="notes-grid">
      {notes.map((note) => (
        <NoteCard note={note} />
      ))}
    </div>
  </section>
  {issue && (
    <section class="research-feature">
      <div class="shell research-grid">
        <div class="research-intro">
          <p class="eyebrow">04 / The reading room</p>
          <div class="issue-number" aria-hidden="true">
            {pad(issue.data.issue)}
            <span>
              Research
              <br />
              fieldnotes
            </span>
          </div>
          <h2>{issue.data.title}</h2>
          <p>
            One paper in depth. Four more in perspective. What the evidence
            says, where it stops, and why it matters for builders.
          </p>
          <div class="research-meta">
            {issue.data.collection} · {formatDate(issue.data.published)}
          </div>
          <a class="button primary" href={`/research/${issue.id}/`}>
            Read the collection <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ol class="paper-list">
          {issue.data.papers.map((paper, i) => (
            <li>
              <span class="paper-index">0{i + 1}</span>
              <div>
                <h3>{paper.title}</h3>
                <p>{paper.finding}</p>
                <span class="paper-year">
                  {paper.published.slice(0, 4)} ·{' '}
                  {i === 0 ? 'In depth' : 'Research note'}
                </span>
              </div>
              <a
                href={paper.url}
                aria-label={`Read original paper: ${paper.title}`}
              >
                ↗
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {latestBrief && (
    <section class="shell latest-brief" aria-labelledby="brief-heading">
      <div>
        <p class="eyebrow">
          Model Fieldnotes · Automated briefing ·{' '}
          {formatDate(latestBrief.data.published)}
        </p>
        <h2 id="brief-heading">
          <a href={`/notes/${latestBrief.id}/`}>{latestBrief.data.title} ↗</a>
        </h2>
        <p>{latestBrief.data.description}</p>
      </div>
      <a class="text-link" href="/notes/?format=Daily+brief">
        All briefings →
      </a>
    </section>
  )}
  <section class="section shell author-section" id="about">
    <div>
      <p class="eyebrow">05 / Behind the fieldnotes</p>
      <div class="author-identity">
        <img
          src="/images/swapnil-upganlawar.jpg"
          width="800"
          height="800"
          alt="Swapnil Upganlawar"
          loading="lazy"
        />
        <div>
          <h2>Hi, I’m Swapnil Upganlawar.</h2>
          <p class="author-role">
            AI & engineering leader. Builder of Model Fieldnotes.
          </p>
        </div>
      </div>
    </div>
    <div>
      <p class="author-lead">
        I connect engineering depth with product judgment: how agents fail, how
        to evaluate them, and what useful outcomes cost.
      </p>
      <p>
        My background spans generative AI, enterprise search, and machine
        learning platforms, with an MBA from Wharton and an MS from Carnegie
        Mellon. I build AI products and lead engineering teams. Model Fieldnotes
        brings that perspective to practical decisions for engineering leaders
        and senior builders.
      </p>
      <div class="author-links">
        <a class="text-link" href="/about/">
          More about me <span aria-hidden="true">→</span>
        </a>
        <a
          class="text-link"
          href="https://www.linkedin.com/in/swapnilupganlawar/"
          rel="me"
        >
          Find me on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="follow-strip shell">
    <div>
      <p class="eyebrow">Keep a thread of curiosity open</p>
      <h2>Follow the next fieldnote.</h2>
      <p>
        Follow signed notes, guides, and research in your feed reader. Automated
        briefings are available in the combined feed.
      </p>
    </div>
    <div>
      <a class="button primary" href="/writing/rss.xml">
        Follow my writing <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/rss.xml">
        All writing & briefings ↗
      </a>
      <a class="text-link" href="https://github.com/swapupg">
        Follow on GitHub ↗
      </a>
    </div>
  </section>
</Base>
