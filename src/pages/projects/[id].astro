---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { visible } from '../../lib/content';
export async function getStaticPaths() {
  return visible(await getCollection('projects')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="shell page-content">
    <header class="page-heading">
      <a class="eyebrow back-link" href="/projects/">
        ← All projects
      </a>
      <p class="pill">{entry.data.stage} · MIT licensed</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="project-actions">
        <a class="button primary" href={entry.data.demo}>
          Open {entry.data.title} ↗
        </a>
        <a class="text-link" href={entry.data.repository}>
          Explore the source ↗
        </a>
      </div>
    </header>
    <figure class="project-detail-image">
      <img
        src={entry.data.image}
        alt={entry.data.imageAlt}
        width="1200"
        height="1282"
      />
      <figcaption>A real view of the browser-based learning lab.</figcaption>
    </figure>
    <div class="prose standalone-prose">
      <Content />
    </div>
  </article>
</Base>
