---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { visible } from '../../lib/content';
export async function getStaticPaths() {
  return visible(await getCollection('research')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Article entry={entry} headings={headings}>
  <div class="research-notice">
    {entry.data.collection} · Issue {String(entry.data.issue).padStart(3, '0')}{' '}
    · Five papers, one connected question.
  </div>
  <Content />
</Article>
